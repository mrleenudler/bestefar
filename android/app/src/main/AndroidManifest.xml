<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Opplasting av koeen (backend_spec §6/§10). Appen er offline-foerst:
         uten nett fungerer alt som foer, koeen blir bare staaende. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Stedslogging av jaktskudd, valgfri og kun lokal lagring (spec §4) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Varsler fra venner og lag (backend_spec §11). Fra Android 13 er dette
         en KJOERETIDS-tillatelse; vi ber om den etter innlogging, ikke ved
         appstart - uten konto finnes det ingen varsler aa gi. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.camera" android:required="true" />

    <!-- allowBackup=false ER ET BEVISST VALG (v0.26). Ikke sett den tilbake
         til true fordi appen «mangler sikkerhetskopi» - appen HAR en, og den
         er klient-kryptert. Androids automatiske kopi ville lagt jaktloggen
         med art, sted og utfall hos Google i klartekst, altsaa noeyaktig det
         den krypterte bloben finnes for aa unngaa. Begrunnelsen i sin helhet
         staar i android/ARCHITECTURE.md, «Androids automatiske sikkerhetskopi
         er slaatt av». -->
    <application
        android:name=".BestefarApp"
        android:label="@string/app_name"
        android:theme="@style/Theme.Bestefar"
        android:allowBackup="false">

        <!-- PORTRETT overalt unntatt Scan (musingsUI runde 10): layoutene er
             bygget for staaende telefon, og liggende ga skjeve/klemte rammer. -->
        <activity android:name=".MainActivity" android:exported="true"
                  android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Landskap: apparatskjermen er 4:3 liggende -> best oppløsning.
             sensorLandscape: roterer mellom begge liggende retninger saa
             tekst aldri blir opp-ned (musingsUI runde 3) -->
        <activity android:name=".CaptureActivity" android:exported="false"
                  android:screenOrientation="sensorLandscape" />
        <activity android:name=".ResultActivity" android:exported="false"
                  android:screenOrientation="portrait" />
        <activity android:name=".SummaryActivity" android:exported="false"
                  android:screenOrientation="portrait" />
        <activity android:name=".HuntLogActivity" android:exported="false"
                  android:screenOrientation="portrait" />
        <activity android:name=".ProfilActivity" android:exported="false"
                  android:screenOrientation="portrait" />
        <activity android:name=".SerieloggActivity" android:exported="false"
                  android:screenOrientation="portrait" />
        <activity android:name=".VennerActivity" android:exported="false"
                  android:screenOrientation="portrait" />
        <activity android:name=".JaktActivity" android:exported="false"
                  android:screenOrientation="portrait" />
        <activity android:name=".RegistrerteSkuddActivity" android:exported="false"
                  android:screenOrientation="portrait" />
        <activity android:name=".LagActivity" android:exported="false"
                  android:screenOrientation="portrait" />
        <activity android:name=".AvansertActivity" android:exported="false"
                  android:screenOrientation="portrait" />
        <activity android:name=".TeamPageActivity" android:exported="false"
                  android:screenOrientation="portrait" />
        <activity android:name=".LoggInnActivity" android:exported="false"
                  android:screenOrientation="portrait" />
        <!-- Invitasjonslenke: https://bestefar-api.fly.dev/i/<token> (issue #15).
             MAA vaere exported - det er systemet som starter den fra en lenke.

             android:autoVerify sjekker appens SIGNERINGSSERTIFIKAT mot
             /.well-known/assetlinks.json paa domenet. Et debug-bygg er signert
             med debug-keystoren og verifiserer derfor IKKE; da aapnes lenken i
             nettleseren uten at noe melder fra. Test paa release-APK, og sjekk
             med `adb shell pm get-app-links no.bestefar.app`.

             pathPrefix "/i/" og ikke hele vertsnavnet: resten av domenet er
             API-et, og appen skal ikke fange opp de rutene. -->
        <activity android:name=".InviteActivity" android:exported="true"
                  android:screenOrientation="portrait"
                  android:launchMode="singleTask">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                      android:host="bestefar-api.fly.dev"
                      android:pathPrefix="/i/" />
            </intent-filter>
        </activity>
        <!-- KalkulatorActivity fjernet i runde 4 (optikk-funksjonalitet
             kommentert ut for aa forenkle) -->
        <!-- Push-mottak (backend_spec §11). Naar appen ligger i BAKGRUNNEN
             tegner Android selv varselet ut fra notification-blokka og
             meta-dataene under; tjenesten kalles kun i forgrunnen. -->
        <service android:name=".PushService" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon"
                   android:resource="@drawable/ic_notification" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_color"
                   android:resource="@color/notification_accent" />
        <!-- MAA peke paa en kanal appen faktisk oppretter (Push.ensureChannel),
             ellers havner bakgrunnsvarsler i «Diverse». -->
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id"
                   android:value="bestefar_varsler" />

        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr" />
    </application>
</manifest>
