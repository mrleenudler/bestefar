<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Opplasting av koeen (backend_spec §6/§10). Appen er offline-foerst:
         uten nett fungerer alt som foer, koeen blir bare staaende. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Stedslogging av jaktskudd, valgfri og kun lokal lagring (spec §4) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.camera" android:required="true" />

    <application
        android:name=".BestefarApp"
        android:label="@string/app_name"
        android:theme="@style/Theme.Bestefar"
        android:allowBackup="true">

        <!-- PORTRETT overalt unntatt Scan (musingsUI runde 10): layoutene er
             bygget for staaende telefon, og liggende ga skjeve/klemte rammer. -->
        <activity android:name=".MainActivity" android:exported="true"
                  android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Landskap: apparatskjermen er 4:3 liggende -> best oppløsning.
             sensorLandscape: roterer mellom begge liggende retninger saa
             tekst aldri blir opp-ned (musingsUI runde 3) -->
        <activity android:name=".CaptureActivity" android:exported="false"
                  android:screenOrientation="sensorLandscape" />
        <activity android:name=".ResultActivity" android:exported="false"
                  android:screenOrientation="portrait" />
        <activity android:name=".SummaryActivity" android:exported="false"
                  android:screenOrientation="portrait" />
        <activity android:name=".HuntLogActivity" android:exported="false"
                  android:screenOrientation="portrait" />
        <activity android:name=".ProfilActivity" android:exported="false"
                  android:screenOrientation="portrait" />
        <activity android:name=".SerieloggActivity" android:exported="false"
                  android:screenOrientation="portrait" />
        <activity android:name=".VennerActivity" android:exported="false"
                  android:screenOrientation="portrait" />
        <activity android:name=".JaktActivity" android:exported="false"
                  android:screenOrientation="portrait" />
        <activity android:name=".RegistrerteSkuddActivity" android:exported="false"
                  android:screenOrientation="portrait" />
        <activity android:name=".LagActivity" android:exported="false"
                  android:screenOrientation="portrait" />
        <activity android:name=".AvansertActivity" android:exported="false"
                  android:screenOrientation="portrait" />
        <activity android:name=".TeamPageActivity" android:exported="false"
                  android:screenOrientation="portrait" />
        <activity android:name=".LoggInnActivity" android:exported="false"
                  android:screenOrientation="portrait" />
        <!-- KalkulatorActivity fjernet i runde 4 (optikk-funksjonalitet
             kommentert ut for aa forenkle) -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr" />
    </application>
</manifest>
