    <!-- Samtykke -->
    <string name="consent_research_title">Bidra til forskning?</string>
    <string name="consent_research_body">Hjelp oss å lære om hvordan øvelsesskyting påvirker jakt.\n\nDu deler bare resultatene fra øvelsesskyting og jakt, aldri personlig informasjon.\n\nDu kan når som helst stoppe delingen og trekke tilbake samtykket fra menyen. Da vil alle data om deg slettes fra forskningsprosjektet.</string>
    <string name="consent_hunt_title">Dele jaktdata?</string>
    <string name="consent_hunt_body">Jaktloggen kan deles pseudonymt til forskning, med stedsoppløsning du velger. Skadedata er alltid private som standard. Avslag endrer ingen funksjonalitet.</string>
