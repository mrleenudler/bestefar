        android:pathData="M12,1.5 A10.5,10.5 0 1 1 11.99,1.5 Z
                          M12,3.7 A8.3,8.3 0 1 0 12.01,3.7 Z"/>
    <!-- Indre ring -->
    <path android:fillColor="#FFFFFFFF" android:fillType="evenOdd"
        android:pathData="M12,6.2 A5.8,5.8 0 1 1 11.99,6.2 Z
                          M12,8.4 A3.6,3.6 0 1 0 12.01,8.4 Z"/>
