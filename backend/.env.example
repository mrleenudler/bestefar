# Kopier til backend/.env for lokal kjoering. .env er gitignorert - fyll aldri
# inn ekte hemmeligheter i .env.example.
#
# I produksjon settes de samme verdiene som Fly secrets:
#   flyctl secrets set DATABASE_URL=... FEEDBACK_TO=... -a bestefar-api

ENV=dev
LOG_LEVEL=INFO

# SQLite lokalt; Supabase-strengen (Direct connection) i produksjon:
#   postgresql://postgres:<passord>@db.puioipitfilhqnarrsup.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./bestefar.db
AUTO_CREATE_TABLES=true

# --- Feedback (§10) ---
FEEDBACK_TO=
FEEDBACK_FROM=bestefar@bestefar.app
FEEDBACK_RATE_PER_HOUR=5
# Velg EN videresendingskanal (ellers logges meldingen bare):
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
