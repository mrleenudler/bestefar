# Kopier til backend/.env for lokal kjoering. .env er gitignorert - fyll aldri
# inn ekte hemmeligheter i .env.example.
#
# I produksjon settes de samme verdiene som Fly secrets:
#   flyctl secrets set DATABASE_URL=... FEEDBACK_TO=... -a bestefar-api

ENV=dev
LOG_LEVEL=INFO

# SQLite lokalt; Supabase-strengen (Direct connection) i produksjon:
#   postgresql://postgres:<passord>@db.puioipitfilhqnarrsup.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./bestefar.db
AUTO_CREATE_TABLES=true

# --- Innlogging (§1) ---
# Noekkelen vaare egne tokens signeres med. MINST 32 tegn - kortere avvises.
#   openssl rand -base64 48
# Roteres den, blir alle utstedte access-tokens ugyldige med én gang og
# klientene maa logge inn paa nytt. Tom => /v1/auth/* svarer 503.
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=90

# Kommaseparert; sjekkes mot `aud` i ID-tokenet. Tom => 503 for den
# leverandoeren.
#
# GOOGLE: WEB-klient-ID-en, ikke Android-klient-ID-en. Android trenger sin egen
# klient for SHA-1-bindingen, men Credential Manager utsteder ID-tokens med
# web-klienten som `aud` - samme verdi som klienten sender til
# setServerClientId(). Android-ID-en her => alle tokens avvises.
GOOGLE_CLIENT_IDS=
# APPLE: Services ID-en (ikke bundle-ID-en) naar innloggingen skjer fra Android.
APPLE_CLIENT_IDS=

EMAIL_CODE_TTL_MINUTES=15
EMAIL_CODE_MAX_ATTEMPTS=5
# Teller FORESPOERSLER, ikke leveranser: en bruker som ber om ny kode fordi
# e-posten er treg, skal ikke brenne opp kvoten sin.
EMAIL_CODE_RATE_PER_HOUR=10
# Sperrefrist for «send ny kode». Klienten faar verdien tilbake i svaret fra
# /v1/auth/email/start og teller ned paa den.
EMAIL_CODE_RESEND_COOLDOWN_SECONDS=60

# --- Push (§11) ---
# Tjenestekontoen fra Firebase (Prosjektinnstillinger -> Tjenestekontoer ->
# «Generer ny privat noekkel»), enten som raa JSON eller base64-kodet - koden
# godtar begge. Tom => push logges bare, og meldingskoeen alene baerer varselet.
#
# PowerShell (base64 anbefales - noekkelfilen er flerlinjes og sitering av den
# raa er en felle):
#   $b64 = [Convert]::ToBase64String([IO.File]::ReadAllBytes("noekkel.json"))
#   flyctl secrets set FCM_SERVICE_ACCOUNT_JSON=$b64 -a bestefar-api
#
# NB: filen inneholder en privat noekkel. Den skal ALDRI committes.
FCM_SERVICE_ACCOUNT_JSON=
# Leses fra JSON-en om den staar tom.
FCM_PROJECT_ID=
PUSH_TIMEOUT_SECONDS=5
PUSH_BUDGET_SECONDS=6

# --- Backup: noekkeldeponering (§2) ---
# Hemmeligheten som DEPONERT noekkelmateriale krypteres med i ro. Tom =>
# /v1/backup/key-escrow svarer 503, og «gjenopprett uten kode» er ikke
# tilgjengelig. Vi lagrer heller ingenting enn aa lagre noekler i klartekst.
#   openssl rand -base64 48
# ROTERES ALDRI uten at brukerne varsles: alle deponerte noekler blir uleselige
# og kopien kan da bare aapnes med gjenopprettingskoden.
BACKUP_ESCROW_SECRET=
# Den FORRIGE hemmeligheten. Staar normalt tom. Skal du bytte den over:
#   1. sett BACKUP_ESCROW_SECRET_OLD = dagens verdi
#   2. sett BACKUP_ESCROW_SECRET = den nye
#   3. foelg /health («escrow») til den sier "ok" - radene krypteres om
#      etter hvert som de leses
#   4. fjern BACKUP_ESCROW_SECRET_OLD
# Uten dette steget blir alt deponert materiale uleselig i samme oeyeblikk.
BACKUP_ESCROW_SECRET_OLD=

# --- Feedback (§10) ---
FEEDBACK_TO=
FEEDBACK_FROM=bestefar@bestefar.app
FEEDBACK_RATE_PER_HOUR=5
# Velg EN videresendingskanal (ellers logges meldingen bare):
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
